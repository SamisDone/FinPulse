# FinPulse configuration. Copy to .env and adjust; every setting is optional.

# ---- App -------------------------------------------------------------------
# Show detailed errors in the browser. Keep false in production.
APP_DEBUG=false

# The public address people use. Needed for links in emails sent by scripts/cron.php,
# and when FinPulse runs in a subfolder, e.g. https://example.com/finpulse
APP_URL=http://localhost:8000

# Decides what "today" and "this month" mean. https://www.php.net/manual/en/timezones.php
APP_TIMEZONE=UTC

# ---- Database --------------------------------------------------------------
# sqlite (default, zero setup) or mysql
DB_TYPE=sqlite

# SQLite file, relative to the project root. Keep it outside public/.
DB_PATH=storage/finpulse.db

# MySQL / MariaDB (used when DB_TYPE=mysql). Tables are created automatically.
# You can either set individual DB_* variables OR a single DATABASE_URL:
# DATABASE_URL=mysql://user:password@gateway01.region.tidbcloud.com:4000/finpulse
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=finpulse
DB_USER=finpulse
DB_PASS=

# ---- Email -----------------------------------------------------------------
# log  = save emails as .eml files in MAIL_LOG_PATH (default; good for trying things out)
# smtp = send through an SMTP server (Gmail, Outlook, Mailgun, your host...)
# mail = use PHP's mail() function
# none = never send email (password reset by email won't be available)
MAIL_DRIVER=log
MAIL_LOG_PATH=storage/mail

MAIL_HOST=smtp.example.com
# 587 with MAIL_ENCRYPTION=tls (STARTTLS), or 465 with MAIL_ENCRYPTION=ssl
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=finpulse@example.com
MAIL_FROM_NAME=FinPulse
MAIL_TIMEOUT=15
