# Sixpence configuration. Copy to .env and adjust; every setting is optional.

# ---- App -------------------------------------------------------------------
# Show detailed errors in the browser. Keep false in production.
APP_DEBUG=false

# The public address people use. Needed for links in emails sent by scripts/cron.php,
# and when Sixpence runs in a subfolder, e.g. https://example.com/sixpence
APP_URL=http://localhost:8000

# Decides what "today" and "this month" mean. https://www.php.net/manual/en/timezones.php
APP_TIMEZONE=UTC

# ---- Database --------------------------------------------------------------
# Sixpence runs on PostgreSQL 13+. Set either a single DATABASE_URL or the
# individual DB_* variables; DATABASE_URL wins when both are present. Tables are
# created and migrated automatically on first connect.
#
#   DATABASE_URL=postgres://user:password@host:5432/sixpence
#
# Managed Postgres (Render, Neon, Supabase) needs TLS. Any host other than
# localhost defaults to sslmode=require; override with DB_SSLMODE or by adding
# ?sslmode=... to DATABASE_URL.
DATABASE_URL=postgres://user:password@host:5432/sixpence
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sixpence
DB_USER=postgres
DB_PASS=
# DB_SSLMODE=require

# ---- Email -----------------------------------------------------------------
# log  = save emails as .eml files in MAIL_LOG_PATH (default; good for trying things out)
# smtp = send through an SMTP server (Gmail, Outlook, Mailgun, your host...)
# mail = use PHP's mail() function
# none = never send email (password reset by email won't be available)
MAIL_DRIVER=log
MAIL_LOG_PATH=storage/mail

MAIL_HOST=smtp.example.com
# 587 with MAIL_ENCRYPTION=tls (STARTTLS), or 465 with MAIL_ENCRYPTION=ssl
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=sixpence@example.com
MAIL_FROM_NAME=Sixpence
MAIL_TIMEOUT=15
