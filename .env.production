# FinPulse production environment for AWS EC2.
# Copy this to .env on your server and fill in the values.

# ---- App -------------------------------------------------------------------
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_TIMEZONE=UTC

# ---- Database (MySQL, managed by Docker Compose) ---------------------------
DB_TYPE=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=finpulse
DB_USER=finpulse
DB_PASS=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_TO_A_STRONG_ROOT_PASSWORD

# ---- Caddy domain ----------------------------------------------------------
# Set to your domain for automatic HTTPS, or localhost for HTTP only.
DOMAIN=localhost

# ---- Email (optional) ------------------------------------------------------
MAIL_DRIVER=log
MAIL_LOG_PATH=storage/mail
# To send real emails, switch to smtp and fill these in:
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM_ADDRESS=your-email@gmail.com
# MAIL_FROM_NAME=FinPulse
