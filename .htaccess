# FinPulse: fallback for hosts where the document root can't point at public/.
# Everything is served from public/; app code, the database and scripts stay unreachable.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
